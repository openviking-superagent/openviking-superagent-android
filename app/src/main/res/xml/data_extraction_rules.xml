<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The saved server URL and token are device-local; never copy them out. -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
