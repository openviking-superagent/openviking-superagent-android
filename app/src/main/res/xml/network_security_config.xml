<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The console and the optional gateway are usually reached over a local
         tunnel with plain HTTP. HTTPS is still preferred for public endpoints. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
